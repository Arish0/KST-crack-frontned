{
  "name": "kst-customer",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "kstcrackers.shop", "custom_domain": true },
    { "pattern": "www.kstcrackers.shop", "custom_domain": true }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "BACKEND",
      "service": "kst-backend"
    }
  ],
  "vars": {
    "SITE_ROLE": "customer"
  },
  "previews": {
    "vars": {
      "SITE_ROLE": "customer"
    }
  },
  "account_id": "58cf4c0436d6ae15fcc2585cb8bf9c61"
}
